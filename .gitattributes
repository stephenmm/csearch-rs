# Normalize line endings so Windows-git and WSL-git share this repo cleanly.
* text=auto eol=lf

# Scripts that must keep their native endings
*.ps1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh  text eol=lf

# Treat these as binary (never touch endings)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.stl binary
*.3mf binary
